<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="gemstone_xos"
          fetch="https://github.com/halogenOS"
          clone-depth="1" />

  <remote name="gemstone_crdroid"
          fetch="https://github.com/crdroidandroid"
          clone-depth="1" />

  <remote name="gemstone_charvik"
          fetch="https://github.com/IamCharvik"
          clone-depth="1" />

  <remote name="gemstone_lineage"
          fetch="https://github.com/LineageOS"
          clone-depth="1" />

  <!-- Replace the stock HalogenOS projects with the Duress-enabled forks. -->
  <remove-project name="android_frameworks_base" />
  <remove-project name="android_packages_apps_Settings" />

  <project name="android_frameworks_base"
           path="frameworks/base"
           remote="gemstone_charvik"
           revision="XOS-16.2" />

  <project name="android_packages_apps_Settings"
           path="packages/apps/Settings"
           remote="gemstone_charvik"
           revision="XOS-16.2" />

  <!-- Unified gemstone + SM6375 common device tree (XOS-adapted branch) -->
  <project name="Unified_SM6375_Device_Tree_Common-Gemstone"
           path="device/xiaomi/gemstone"
           remote="gemstone_charvik"
           revision="xos-16.2" />

  <!-- Device vendor tree -->
  <project name="proprietary_vendor_xiaomi_gemstone"
           path="vendor/xiaomi/gemstone"
           remote="gemstone_charvik"
           revision="16.0" />

  <!-- Common vendor tree -->
  <project name="proprietary_vendor_xiaomi_sm6375-common"
           path="vendor/xiaomi/sm6375-common"
           remote="gemstone_charvik"
           revision="16.0" />

  <!-- Custom kernel -->
  <project name="android_kernel_xiaomi_moonstone"
           path="kernel/xiaomi/sm6375"
           remote="gemstone_charvik"
           revision="lineage-23.2" />

  <!-- Xiaomi hardware support -->
  <project name="android_hardware_xiaomi"
           path="hardware/xiaomi"
           remote="gemstone_lineage"
           revision="lineage-23.2" />
</manifest>
